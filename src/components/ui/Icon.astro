const isFill = name in fills;
const body = isFill ? fills[name] : lines[name];
if (!body) throw new Error(`Icon "${name}" is not in src/components/ui/Icon.astro`);
const stroke = grad ? 'url(#rw-grad)' : 'currentColor';
---
{isFill ? (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill={grad ? 'url(#rw-grad)' : 'currentColor'} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" set:html={body} />
) : (
  <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" set:html={body} />
)}
