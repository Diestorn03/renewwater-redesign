---
/**
 * Offer ticket with perforated edges (radial-gradient mask) and an optional amber stamp. Theme-aware.
 * <TicketStub title="Instalación gratuita" text="…" stamp="GRATIS" icon="wrench" />
 * The stamp is decorative, so the title must already say the offer ("Instalación gratuita").
 */
import Icon from './Icon.astro';
import Stamp from './Stamp.astro';
interface Props { title: string; text?: string; stamp?: string; icon?: string; class?: string }
const { title, text, stamp, icon = 'check', class: cls } = Astro.props;
---
<div class:list={['ticket', cls]}>
  <div class="ticket__paper">
    <span class="ticket__stub" aria-hidden="true"><Icon name={icon} size={28} /></span>
    <div class="ticket__main">
      <h3 class="ticket__title">{title}</h3>
      {text && <p class="ticket__text">{text}</p>}
    </div>
  </div>
  {stamp && <Stamp text={stamp} class="ticket__stamp" />}
</div>

<style>
  /* Theme comes from the nearest [data-theme] only: tokens + light-dark() (it follows the inherited color-scheme),
     never a [data-theme] ancestor selector, which would also match <html data-theme="dark"> */
  .ticket {
    --stub: 76px;
    position: relative;
    filter: drop-shadow(0 18px 22px rgba(0, 28, 56, .14));
    filter: drop-shadow(0 18px 24px light-dark(rgba(0, 28, 56, .13), rgba(0, 0, 0, .4)));
  }

  .ticket__paper {
    --r: 5px; --gap: 15px; --notch: 10px;
    display: grid; grid-template-columns: var(--stub) 1fr; align-items: stretch;
    min-height: 132px; height: 100%;
    color: var(--fg);
    background: var(--surface);
    background: linear-gradient(135deg, light-dark(#FFFFFF, #0B3B66) 0%, var(--surface) 55%, light-dark(#F1FAF7, #05264A) 100%);
    border-radius: var(--r-sm);
    box-shadow: inset 0 0 0 1px var(--line), inset 0 1px 0 rgba(0, 208, 208, .28);
    /* four cuts intersected: scalloped left + right edges, and two notches where the stub tears off */
    -webkit-mask:
      radial-gradient(circle var(--r) at 0 50%, #0000 96%, #000) 0 0 / 100% var(--gap) repeat-y,
      radial-gradient(circle var(--r) at 100% 50%, #0000 96%, #000) 0 0 / 100% var(--gap) repeat-y,
      radial-gradient(circle var(--notch) at var(--stub) 0, #0000 96%, #000),
      radial-gradient(circle var(--notch) at var(--stub) 100%, #0000 96%, #000);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle var(--r) at 0 50%, #0000 96%, #000) 0 0 / 100% var(--gap) repeat-y,
      radial-gradient(circle var(--r) at 100% 50%, #0000 96%, #000) 0 0 / 100% var(--gap) repeat-y,
      radial-gradient(circle var(--notch) at var(--stub) 0, #0000 96%, #000),
      radial-gradient(circle var(--notch) at var(--stub) 100%, #0000 96%, #000);
    mask-composite: intersect;
  }

  .ticket__stub {
    position: relative; display: grid; place-items: center;
    color: var(--accent-text);
    background: color-mix(in srgb, var(--aqua) 8%, transparent);
  }
  /* the tear line */
  .ticket__stub::after {
    content: ""; position: absolute; right: -1px; top: calc(var(--notch) + 6px); bottom: calc(var(--notch) + 6px); width: 2px;
    background: radial-gradient(circle, var(--fg-muted) 0 1px, transparent 1.5px) 0 0 / 2px 8px repeat-y;
    opacity: .45;
  }

  .ticket__main { min-width: 0; display: grid; align-content: center; gap: .35rem; padding: 1.15rem 1.5rem 1.15rem 1.25rem; }
  .ticket__title { font-size: 1.12rem; line-height: 1.25; letter-spacing: -.01em; font-weight: 600; padding-right: 3.5rem; }
  .ticket__text { font-size: var(--fs-small); line-height: 1.5; color: var(--fg-muted); }

  /* Stamp is a child component: its root does not carry this component's scope attribute */
  .ticket > :global(.ticket__stamp) { position: absolute; top: -14px; right: 14px; }

  @media (prefers-contrast: more) {
    .ticket__paper { box-shadow: inset 0 0 0 2px currentColor; }
  }
</style>
