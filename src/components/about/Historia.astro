---
// Sobre Nosotros · historia (dark): sticky title, the three paragraphs light up in turn, team photos drift at three depths.
import copy from '../../i18n/areas/about.js';
import { pick, useI18n } from '../../i18n/index.js';
import { team } from '../../data/photos.js';

const { o, lang, asset } = useI18n(Astro);
const c = pick(copy, lang).history;
const paragraphs = [o.aboutUs.historyP1, o.aboutUs.historyP2, o.aboutUs.historyP3];
// team-2…5, alternate sides/heights, parallax depth .15 / .3 / .45 (desktop gate only, engine [data-parallax])
const photos = team.slice(1).map((p, i) => ({ ...p, alt: c.photoAlts[i], depth: [0.15, 0.45, 0.3, 0.45][i] }));
---
<section id="historia" class="section hist" data-theme="dark" aria-labelledby="hist-title">
  <div class="wrap hist__grid">
    <div class="hist__head">
      <p class="kicker">{c.kicker}</p>
      <h2 id="hist-title" class="h2" data-split="lines">{o.aboutUs.historyTitle}</h2>
      <ol class="hist__rail" aria-hidden="true">{paragraphs.map((_, i) => <li class="num">0{i + 1}</li>)}</ol>
    </div>
    <div class="hist__body">
      {paragraphs.map((p, i) => (
        <div class="hist__p">
          <span class="num hist__n" aria-hidden="true">0{i + 1}</span>
          <p data-lit>{p}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="wrap hist__photos">
    {photos.map((p, i) => (
      <figure class:list={['hist__photo', `hist__photo--${i + 1}`]} data-parallax={p.depth}>
        <img src={asset(p.src)} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />
      </figure>
    ))}
  </div>
</section>

<style>
  .hist { overflow: clip; }
  .hist__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .hist__head { position: sticky; top: calc(var(--header-h) + 32px); display: grid; gap: 1.25rem; }
  .hist__rail { list-style: none; display: flex; gap: .5rem; margin-top: .5rem; }
  .hist__rail li { font-size: .8rem; padding: .35rem .6rem; border-radius: var(--r-pill); border: 1px solid var(--line); color: var(--fg-muted); }
  .hist__body { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
  .hist__p { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; }
  .hist__n { font-size: 1rem; padding-top: .55rem; background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hist__p p { font-size: clamp(1.2rem, 1rem + .75vw, 1.65rem); line-height: 1.45; letter-spacing: -.01em; }

  .hist__photos { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(12px, 2vw, 28px); margin-top: clamp(4rem, 9vw, 8rem); align-items: start; }
  .hist__photo { margin: 0; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--sh-card-dark); position: relative; }
  .hist__photo img { width: 100%; height: 100%; object-fit: cover; }
  .hist__photo::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(234, 251, 249, .08); pointer-events: none; }
  .hist__photo--1 { grid-column: 1 / span 4; aspect-ratio: 1; margin-top: 6rem; }
  .hist__photo--2 { grid-column: 5 / span 3; aspect-ratio: 3 / 4; }
  .hist__photo--3 { grid-column: 8 / span 2; aspect-ratio: 3 / 4; margin-top: 10rem; }
  .hist__photo--4 { grid-column: 10 / span 3; aspect-ratio: 3 / 4; margin-top: 3rem; }

  @media (max-width: 900px) {
    .hist__grid { grid-template-columns: 1fr; }
    .hist__head { position: static; }
    .hist__rail { display: none; }
    .hist__p { grid-template-columns: 2.2rem minmax(0, 1fr); }
    /* phones: a 2×2 grid after the text */
    .hist__photos { grid-template-columns: 1fr 1fr; margin-top: 3rem; }
    .hist__photo--1, .hist__photo--2, .hist__photo--3, .hist__photo--4 { grid-column: auto; margin-top: 0; aspect-ratio: 4 / 5; }
    .hist__photo--2, .hist__photo--4 { transform: translateY(1.5rem); }
  }
</style>
