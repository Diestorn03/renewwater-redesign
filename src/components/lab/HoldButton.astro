---
// 88 px press-and-hold button with an SVG progress ring (spec §8). Behaviour lives in src/scripts/lab/lab.js.
interface Props { label: string; hint: string; step?: string; stepLabel?: string }
const { label, hint, step = '04', stepLabel } = Astro.props;
---
<div class="hold" data-hold>
  <button type="button" class="hold__btn" data-hold-btn aria-labelledby="hold-label" aria-describedby="hold-hint">
    <svg class="hold__ring" viewBox="0 0 88 88" aria-hidden="true" focusable="false">
      <circle class="hold__track" cx="44" cy="44" r="42" />
      <circle class="hold__prog" data-hold-ring cx="44" cy="44" r="42" pathLength="100" />
    </svg>
    <svg class="hold__icon hold__icon--drop" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="url(#rw-grad)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.8 5.6 12.4a7.2 7.2 0 1 0 12.8 0Z" /><path d="M8.6 14.2a3.6 3.6 0 0 0 3.4 3.4" />
    </svg>
    <svg class="hold__icon hold__icon--check" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m4.5 12.5 4.8 4.8L19.5 7" />
    </svg>
  </button>
  <div class="hold__text">
    {stepLabel && <span class="hold__step"><span class="num">{step}</span> {stepLabel}</span>}
    <span class="hold__label" id="hold-label" data-hold-label>{label}</span>
    <span class="hold__hint" id="hold-hint">{hint}</span>
  </div>
</div>

<style>
  .hold { display: flex; align-items: center; gap: 1.1rem; }
  .hold__btn {
    position: relative; flex: none; width: 88px; height: 88px; border-radius: 50%; border: 0; padding: 0;
    display: grid; place-items: center; color: var(--fg);
    background: radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--aqua) 16%, var(--surface)), var(--bg) 78%);
    box-shadow: inset 0 0 0 1px var(--line), 0 18px 40px -18px rgba(0, 208, 208, .55);
    touch-action: none; -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
    transition: transform var(--d-base) var(--ease-water), box-shadow var(--d-base) var(--ease-water);
  }
  .hold__btn::after {   /* idle invitation: a soft ring that breathes outward */
    content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid rgba(0, 208, 208, .45);
    animation: hold-breathe 2.6s var(--ease-out) infinite; pointer-events: none;
  }
  .hold__btn:hover { box-shadow: inset 0 0 0 1px rgba(0, 208, 208, .5), 0 18px 44px -14px rgba(0, 208, 208, .7); }
  .hold__btn:focus-visible { outline: 3px solid var(--focus); outline-offset: 5px; border-radius: 50%; }
  .hold.is-holding .hold__btn { transform: scale(.94); box-shadow: var(--sh-glow); }
  .hold.is-holding .hold__btn::after, .hold.is-done .hold__btn::after { animation: none; opacity: 0; }
  .hold__ring { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  .hold__track { fill: none; stroke: var(--line); stroke-width: 3; }
  .hold__prog { fill: none; stroke: url(#rw-grad); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; }
  .hold__icon { grid-area: 1 / 1; transition: transform var(--d-base) var(--ease-water), opacity var(--d-base); }
  .hold__icon--check { opacity: 0; transform: scale(.6); color: var(--aqua); }
  .hold.is-holding .hold__icon--drop { transform: scale(.88) rotate(-8deg); }
  .hold.is-done .hold__icon--drop { opacity: 0; transform: scale(.6); }
  .hold.is-done .hold__icon--check { opacity: 1; transform: none; }
  .hold.is-done .hold__btn { cursor: default; box-shadow: var(--sh-glow); }
  .hold__text { display: grid; gap: .15rem; line-height: 1.25; }
  .hold__step { font-family: var(--font-mono); font-size: var(--fs-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent-text); display: inline-flex; gap: .45rem; align-items: baseline; }
  .hold__step .num { font-size: .8rem; }
  .hold__label { font-weight: 600; font-size: 1.05rem; }
  .hold__hint { font-size: var(--fs-small); color: var(--fg-muted); }
  .hold.is-done .hold__hint { visibility: hidden; }
  @keyframes hold-breathe { 0% { transform: scale(.94); opacity: .9 } 70%, 100% { transform: scale(1.18); opacity: 0 } }
  @media (prefers-reduced-motion: reduce) { .hold__btn::after { animation: none; opacity: .5; transform: none; } }
</style>
