---
// Lab result ("lab report" card). Filled and revealed by src/scripts/lab/lab.js (rules in src/data/lab-rules.json).
import Icon from '../ui/Icon.astro';
interface Props {
  copy: Record<string, any>;                    // lab area copy (c.result, c.note)
  simulation: string;
  trust: string;
  fallbackHref: string;                          // generic analysis wa.me link, replaced with the composed message
  thumb: string;                                 // initial image (replaced per result)
  drink: { name: string; url: string }[];        // [osmosis-inversa, astrid]
}
const { copy: c, simulation, trust, fallbackHref, thumb, drink } = Astro.props;
const r = c.result;
---
<article class="result" data-theme="light" data-lab-result data-kind="product" hidden tabindex="-1" aria-labelledby="lab-result-title">
  <header class="result__top">
    <span class="result__label mono">{r.label}</span>
    <span class="disclaimer">{simulation}</span>
  </header>

  <div class="result__main">
    <a class="result__media" data-r-see href="#" aria-hidden="true" tabindex="-1">
      <img data-r-img src={thumb} width="560" height="725" alt="" loading="lazy" decoding="async" />
    </a>
    <div class="result__info">
      <p class="result__suggest">{r.suggest}</p>
      <h3 class="result__title" id="lab-result-title" data-r-title>…</h3>
      <p class="badge-num" data-r-stages hidden></p>
      <p class="result__line" data-r-line></p>
      <p class="result__line result__analysis">{r.analysisText}</p>
      <a class="btn btn--text result__see" data-r-see href="#">{r.see} <Icon name="arrow" size={18} class="arrow" /></a>
    </div>
  </div>

  <ul class="result__extra" role="list">
    <li data-r-alt><Icon name="filter" size={20} /><span>{r.alt} <a href="#"></a></span></li>
    <li data-r-drink hidden>
      <Icon name="tap" size={20} />
      <span>{r.drink} <a href={drink[0].url}>{drink[0].name}</a> ({r.under}) {r.or} <a href={drink[1].url}>{drink[1].name}</a> ({r.dispenser})</span>
    </li>
  </ul>

  <div class="result__actions">
    <a class="btn btn--primary btn--wa" data-r-cta href={fallbackHref} target="_blank" rel="noopener">
      <span class="btn__glyph"><Icon name="whatsapp" size={22} /></span>{r.cta}
    </a>
    <button type="button" class="btn btn--ghost btn--sm" data-r-repeat>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7L4 8.5" /><path d="M4 3.5v5h5" /></svg>
      {r.repeat}
    </button>
  </div>
  <p class="trust-note">{trust}</p>
</article>

<style>
  .result {
    position: relative; background: var(--surface); color: var(--fg); border-radius: var(--r-lg);
    padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, .7), var(--sh-glow);
    display: grid; gap: 1.25rem; transform-style: preserve-3d; backface-visibility: hidden;
  }
  .result[hidden] { display: none; }
  .result:focus { outline: none; }
  .result:focus-visible { outline: 3px solid var(--aqua); outline-offset: 4px; }
  .result::before {   /* perforated "lab report" edge */
    content: ""; position: absolute; left: 24px; right: 24px; top: -5px; height: 10px;
    background: radial-gradient(circle at 5px 5px, var(--navy) 4px, transparent 4.5px) 0 0 / 18px 10px repeat-x;
  }
  .result__top { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-bottom: .9rem; border-bottom: 1px dashed var(--line); }
  .result__label { color: var(--accent-text); }
  .result__main { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
  .result__media {
    display: block; border-radius: var(--r-sm); overflow: hidden; background: var(--mist);
    box-shadow: 0 16px 30px -18px rgba(0, 28, 56, .5); transform: rotate(-2.5deg);
    transition: transform var(--d-base) var(--ease-water);
  }
  .result__media:hover { transform: rotate(0) scale(1.03); }
  .result__media img { width: 100%; height: auto; mix-blend-mode: multiply; }
  .result__info { display: grid; gap: .5rem; justify-items: start; }
  .result__suggest { font-size: var(--fs-small); color: var(--fg-muted); }
  .result__title { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem); line-height: 1.1; letter-spacing: -.02em; }
  .result__line { color: var(--fg-muted); font-size: .98rem; line-height: 1.5; }
  [data-r-line] { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .result__see { font-size: .95rem; }
  .result__analysis, [data-kind="analysis"] :is(.result__media, .result__suggest, [data-r-line], [data-r-stages], .result__see) { display: none; }
  [data-kind="analysis"] .result__analysis { display: block; }
  [data-kind="analysis"] .result__main { grid-template-columns: 1fr; }
  .result__extra { list-style: none; display: grid; gap: .6rem; padding: .9rem 1rem; border-radius: var(--r-sm); background: var(--bg); font-size: .95rem; }
  .result__extra li { display: flex; gap: .6rem; align-items: flex-start; }
  .result__extra li[hidden] { display: none; }
  .result__extra :global(svg) { flex: none; margin-top: .15rem; color: var(--accent-text); }
  .result__extra a { color: var(--accent-text); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .result__extra:not(:has(li:not([hidden]))) { display: none; }
  .result__actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; }
  .result__actions .btn--primary { flex: 1 1 auto; }
  @media (max-width: 420px) {
    .result__main { grid-template-columns: 84px minmax(0, 1fr); gap: 1rem; }
    .result__actions > * { flex: 1 1 100%; }
  }
</style>
