---
/**
 * #cero · "$0 que se llena" (SIG-5) · dark.
 * A giant brand-font "$0" (SVG text as a clipPath, aqua outline on top) fills with two looping brand-gradient
 * waves: scrubbed on the desktop gate, once on view elsewhere, already full with reduced motion or no JS.
 * Then the three offer tickets (stamps on 2 and 3), the financing partners marquee and the WhatsApp CTA.
 *
 * <CeroSeLlena compact />  (About page): only the $0, its caption and the tickets, as a <div> that takes the
 * theme of the section you drop it into. Only one instance per page (the SVG uses fixed ids).
 */
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/offer.js';
import { buildWa, partners } from '../../data/site.js';
import TicketStub from '../ui/TicketStub.astro';
import Icon from '../ui/Icon.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const { o, t, lang, asset } = useI18n(Astro);
const c = pick(copy, lang).cero;
const clean = (s: string) => s.replace(/[:\s]+$/, '');

// Ink box of "$0" in Orbitron 400 at 1000 units (fontTools: x 34–1572, y −114…835; the $ stroke pokes out of the
// 720 cap height at both ends). Re-measure if --font-brand changes: the viewBox, clip and water levels depend on it.
const INK = { x0: 34, x1: 1572, top: 835, bottom: 114 }, PAD = 12;
const X = INK.x0 - PAD, Y = -(INK.top + PAD), VW = INK.x1 - INK.x0 + 2 * PAD, VH = INK.top + INK.bottom + 2 * PAD;
const FULL = -Math.round(INK.top * 0.92); // water surface ends 8% below the top of the glyphs
const EMPTY = INK.bottom + 44;           // surface (plus wave amplitude) below the lowest ink
// The water is HTML on GPU layers (it used to be <path>s animated inside an SVG <mask>, which re-laid out and repainted
// the whole "$0" on every frame). Each wave is a strip twice the box wide whose top edge is one period of a
// quadratic-chain sine (the same q + t curve as before), tiled with mask-image and slid by its period with transform;
// the gradient inside counter-slides so its colours stay put. Units: 1 user unit = 1/VW of the box (u() below).
const WAVES = [
  { k: 'back', P: VW / 1.5, A: 26, lift: 16 }, // period, amplitude, lift above the level line (user units)
  { k: 'front', P: VW / 2, A: 21, lift: 0 },
];
const T = VH - FULL + 60; // strip height: still covers the $ tail when the level is raised to FULL
const waves = WAVES.map(({ k, P, A, lift }) => {
  const b = A + 2; // the wave's mean line inside its tile
  const tile = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${P} ${T}' preserveAspectRatio='none'><path d='M0 ${b}q${P / 4} ${-A} ${P / 2} 0t${P / 2} 0V${T}H0Z'/></svg>`;
  return {
    k,
    // the strip's top in box units at level 0 (glyph baseline = INK.top + PAD below the box top)
    style: `--top:${INK.top + PAD - lift - b};--h:${T};--tile:url("data:image/svg+xml,${encodeURIComponent(tile)}");--tile-w:${(100 * P) / (2 * VW)}%;--shift:${(100 * P) / VW}%`,
  };
});

// Logos are 96 px high (tools/prep-logos.py). Display height is optically balanced so wide and compact marks
// weigh the same: equal area around a 32 px reference, clamped to 24–40 px.
const LOGO_W: Record<string, number> = { synchrony: 453, time: 276, ygrene: 262, foundation: 584, homerun: 309, pci: 167, rffc: 310 };
const logos = partners.map((p) => {
  const slug = p.src.split('/').pop()!.replace('.webp', '');
  const ar = LOGO_W[slug] / 96;
  const h = Math.round(Math.min(40, Math.max(24, 32 * Math.sqrt(3.2 / ar))));
  return { ...p, slug, h, w: Math.round(h * ar), white: p.src.replace('.webp', '-white.webp') };
});

const tickets = [
  { title: clean(o.aboutUs.benefit2Title), text: o.aboutUs.benefit2Text, icon: 'wrench', stamp: c.free },
  { title: c.benefit3Title, text: o.aboutUs.benefit3Text, icon: 'flask', stamp: c.free },
  { title: clean(o.aboutUs.benefit4Title), text: o.aboutUs.benefit4Text, icon: 'coin' },
];
const Tag = compact ? 'div' : 'section';
const Title = compact ? 'h3' : 'h2'; // compact sits under the host section's own h2
---
<Tag
  id={compact ? undefined : 'cero'}
  class:list={['cero', compact ? 'cero--compact' : 'section']}
  data-theme={compact ? undefined : 'dark'}
  aria-labelledby={compact ? undefined : 'cero-title'}
  style={`--lvl-full:${FULL};--lvl-empty:${EMPTY};--vh:${VH}`}
>
  <div class:list={[!compact && 'wrap']}>
    <div class="cero__hero">
      <div class="cero__zero-wrap" style={`aspect-ratio:${VW}/${VH};--vw:${VW};--x:${X};--y:${Y}`}>
        <!-- water: tint + two waves, clipped to the "$0" glyphs (objectBoundingBox copy of the same text) -->
        <div class="cero__water" aria-hidden="true">
          <div class="cero__level">
            {waves.map((w) => <div class={`cero__wave cero__wave--${w.k}`} style={w.style}><div class="cero__fill"></div></div>)}
          </div>
        </div>
        <svg class="cero__zero" viewBox={`${X} ${Y} ${VW} ${VH}`} aria-hidden="true" focusable="false">
          <defs>
            <!-- user space of the HTML water layer = its CSS px; the glyphs are laid out at the same real size as the
                 outline (a 1/VW objectBoundingBox scale made Chrome lay the text out at ~0.6px and it came out smaller) -->
            <clipPath id="cero-clip"><text class="cero__glyphs cero__cliptext" x="0" y="0">$0</text></clipPath>
          </defs>
          <text class="cero__glyphs cero__outline" x="0" y="0">$0</text>
        </svg>
      </div>
      <div class="cero__caption">
        <p class="kicker">{c.kicker}</p>
        <Title id={compact ? undefined : 'cero-title'} class="cero__title">{clean(o.aboutUs.benefit1Title)}</Title>
        <p class="cero__text">{o.aboutUs.benefit1Text}</p>
        <p class="cero__credit">{c.credit}</p>
      </div>
    </div>

    <ul class="cero__tickets" role="list">
      {tickets.map((tk) => <li><TicketStub title={tk.title} text={tk.text} icon={tk.icon} stamp={tk.stamp} /></li>)}
    </ul>
  </div>

  {!compact && (
    <div class="cero__partners">
      <h3 class="cero__ptitle wrap">{o.home.financialsTitle}</h3>
      <div class="marquee cero__marquee" data-speed=".5">
        <ul class="marquee__track cero__logos" role="list">
          {logos.map((l) => (
            <li class="cero__logo" style={`--h:${l.h}px`}>
              <img class="cero__logo-w" src={asset(l.white)} width={l.w} height={l.h} alt={l.name} loading="lazy" decoding="async" />
              <img class="cero__logo-c" src={asset(l.src)} width={l.w} height={l.h} alt="" loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap cero__cta">
        <a class="btn btn--primary btn--wa" href={buildWa({ text: c.wa, ref: 'web-financiamiento' })} target="_blank" rel="noopener" data-magnetic>
          <span class="btn__glyph"><Icon name="whatsapp" size={22} /></span>{c.cta}
          <Icon name="arrow" size={18} class="arrow" />
        </a>
        <p class="trust-note">{t.cta.trust}</p>
      </div>
    </div>
  )}
</Tag>

<script>
  import '../../scripts/cero.js';
</script>

<style>
  .cero { position: relative; overflow: clip; }
  .cero:not(.cero--compact) {
    background:
      radial-gradient(60% 55% at 22% 30%, rgba(0, 208, 208, .13), transparent 70%),
      radial-gradient(50% 45% at 90% 85%, rgba(152, 196, 0, .08), transparent 70%),
      var(--bg);
  }

  /* ---------- the $0 ---------- */
  .cero__hero { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .cero__zero-wrap { position: relative; width: min(100%, 680px); container-type: inline-size; }
  .cero__zero { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .cero__glyphs { font-family: var(--font-brand); font-size: 1000px; letter-spacing: 0; }
  /* 100cqw / --vw = CSS px per user unit of the glyph box */
  .cero__cliptext {
    font-size: calc(1000 * 100cqw / var(--vw));
    transform: translate(calc(var(--x) * -100cqw / var(--vw)), calc(var(--y) * -100cqw / var(--vw)));
  }
  .cero__outline { fill: none; stroke: var(--accent-text); stroke-width: 1.5px; vector-effect: non-scaling-stroke; }

  /* water, under the outline: the tint uses tokens only, so compact takes the nearest section theme (aqua on navy,
     aqua-ink on foam). 100cqh / --vh = one user unit of the glyph box. */
  .cero__water {
    position: absolute; inset: 0; overflow: hidden; clip-path: url(#cero-clip); container-type: size;
    background: color-mix(in srgb, var(--accent-text) 6%, transparent);
  }
  /* --lvl: water surface offset (user units). Default full (no JS / reduced), .is-armed = empty, GSAP scrubs it on desktop */
  .cero__level {
    position: absolute; inset: 0; will-change: transform;
    transform: translateY(calc(var(--lvl, var(--lvl-full)) * 100cqh / var(--vh)));
    transition: transform 1.6s var(--ease-water);
  }
  .cero__zero-wrap.is-armed { --lvl: var(--lvl-empty); }
  .cero__wave {
    position: absolute; left: 0; width: 200%; will-change: transform;
    top: calc(var(--top) * 100cqh / var(--vh)); height: calc(var(--h) * 100cqh / var(--vh));
    -webkit-mask: var(--tile) 0 0 / var(--tile-w) 100% repeat-x; mask: var(--tile) 0 0 / var(--tile-w) 100% repeat-x;
  }
  .cero__wave--back { opacity: .55; }
  /* the gradient spans the glyph box (half the strip) and counter-slides, so its colours never move */
  .cero__fill { position: absolute; top: 0; bottom: 0; left: 0; width: 50%; background: var(--grad-brand); will-change: transform; }
  .cero__wave--front { animation: cero-strip-l 4s linear infinite; }
  .cero__wave--front .cero__fill { animation: cero-fill-l 4s linear infinite; }
  .cero__wave--back { animation: cero-strip-r 7.5s linear infinite; }
  .cero__wave--back .cero__fill { animation: cero-fill-r 7.5s linear infinite; }
  .cero__zero-wrap.is-idle :is(.cero__wave, .cero__fill) { animation-play-state: paused; }
  /* one period (--shift of the box = half of it for the 200%-wide strip) per loop: seamless */
  @keyframes cero-strip-l { from { transform: translateX(0); } to { transform: translateX(calc(var(--shift) / -2)); } }
  @keyframes cero-fill-l { from { transform: translateX(0); } to { transform: translateX(var(--shift)); } }
  @keyframes cero-strip-r { from { transform: translateX(calc(var(--shift) / -2)); } to { transform: translateX(0); } }
  @keyframes cero-fill-r { from { transform: translateX(var(--shift)); } to { transform: translateX(0); } }

  .cero__caption { display: grid; gap: var(--s-4); justify-items: start; }
  .cero__title { font-size: var(--fs-h2); line-height: 1.02; letter-spacing: -.03em; }
  .cero__text { font-size: var(--fs-lead); line-height: 1.5; color: var(--fg-muted); max-width: 30ch; }
  .cero__credit { font-size: var(--fs-small); color: var(--fg-muted); } /* credit disclaimer: full muted colour keeps it ≥ 4.5:1 */

  /* ---------- tickets ---------- */
  .cero__tickets { list-style: none; display: grid; gap: var(--s-6) var(--s-5); margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .cero__tickets > li { display: grid; }

  /* ---------- partners ---------- */
  .cero__partners { margin-top: clamp(4rem, 9vw, 7rem); display: grid; gap: var(--s-6); }
  .cero__ptitle { font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -.01em; text-align: center; color: var(--fg); }
  .cero__marquee {
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .cero__logos { list-style: none; display: flex; width: max-content; will-change: transform; }
  .cero__logo {
    position: relative; flex: none; display: grid; place-items: center;
    height: 76px; padding: 0 clamp(22px, 3.2vw, 46px);
  }
  .cero__logo img { height: var(--h); width: auto; grid-area: 1 / 1; transition: opacity var(--d-base) var(--ease-water); }
  .cero__logo-w { opacity: .78; }
  .cero__logo-c { opacity: 0; }
  .cero__logo::before {
    content: ""; position: absolute; inset: 10px 12px; border-radius: var(--r-pill); background: #fff;
    opacity: 0; scale: .9; transition: opacity var(--d-base) var(--ease-water), scale var(--d-base) var(--ease-water);
  }
  @media (hover: hover) {
    .cero__logo:hover::before { opacity: 1; scale: 1; }
    .cero__logo:hover .cero__logo-c { opacity: 1; }
    .cero__logo:hover .cero__logo-w { opacity: 0; }
  }
  .cero__cta { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); text-align: center; }

  /* ---------- layouts ---------- */
  @media (min-width: 640px) {
    .cero__tickets { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  }
  @media (min-width: 960px) {
    .cero__hero { grid-template-columns: 1.35fr 1fr; }
    .cero--compact .cero__hero { grid-template-columns: 1.1fr 1fr; }
  }
  @media (max-width: 767px) {
    .cero__logo { height: 64px; padding: 0 22px; }
    .cero__logo img { height: calc(var(--h) * .85); }
  }
  /* desktop gate: GSAP scrubs --lvl, so no CSS easing on top of it */
  @media (min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cero__level { transition: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cero__wave, .cero__fill { animation: none; }
    .cero__logos { flex-wrap: wrap; justify-content: center; width: auto; transform: none !important; row-gap: 8px; }
    .cero__logos > [aria-hidden="true"] { display: none; }
    .cero__marquee { -webkit-mask: none; mask: none; }
  }
</style>
