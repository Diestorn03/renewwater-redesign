---
// #encuentranos · final CTA and location (spec §6.11). Dark. WhatsApp ref web-final; call lines ordered by language.
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/contact.js';
import { buildWa, phones, address, mapLink, socials } from '../../data/site.js';
import Icon from '../ui/Icon.astro';
import MapFacade from '../contact/MapFacade.astro';

const { t, o, lang } = useI18n(Astro);
const c = pick(copy, lang);
const es = { ...phones.find((p) => p.label === 'ES'), label: t.cta.callEs };
const en = { ...phones.find((p) => p.label === 'US'), label: t.cta.callEn };
const calls = lang === 'en' ? [en, es] : [es, en];
const social = [
  { key: 'instagram', ...socials.instagram },
  { key: 'tiktok', ...socials.tiktok },
  { key: 'facebook', ...socials.facebook },
];
---
<section id="encuentranos" class="section find" data-theme="dark" aria-labelledby="find-title">
  <div class="find__bg" aria-hidden="true">
    <span class="find__word bleed-word">{lang === 'en' ? 'FREE' : 'GRATIS'}</span>
  </div>
  <div class="wrap find__grid">
    <div class="find__cta" data-reveal="up">
      <p class="kicker">{c.find.kicker}</p>
      <h2 id="find-title" class="h2 find__title">{c.find.title} <span class="accent">{c.find.accent}</span>{c.find.titleEnd}</h2>
      <p class="lead">{c.find.lead}</p>
      <div class="find__actions">
        <a class="btn btn--primary btn--wa find__wa" data-magnetic href={buildWa({ text: t.wa.analysis, ref: 'web-final' })} target="_blank" rel="noopener">
          <span class="btn__glyph"><Icon name="whatsapp" size={24} /></span>{t.cta.freeAnalysisLong}
          <Icon name="arrow" size={20} class="arrow" />
        </a>
        <div class="find__calls">
          {calls.map((p) => (
            <a class="find__call" href={`tel:${p.tel}`}>
              <span class="find__call-icon"><Icon name="phone" size={20} /></span>
              <span class="find__call-text"><span>{p.label}</span><b>{p.display}</b></span>
            </a>
          ))}
        </div>
      </div>
      <p class="trust-note"><Icon name="check-circle" size={18} />{t.cta.trust}</p>
    </div>

    <div class="find__place glass" data-reveal="up" data-delay=".12">
      <div class="find__place-head">
        <h3 class="h3">{o.home.whereTitle}</h3>
        <address class="find__addr">
          <span class="find__addr-label mono">{c.find.addressLabel}</span>
          <span>{address.line}</span><span>{address.city}</span>
        </address>
        <a class="btn btn--text" href={mapLink} target="_blank" rel="noopener">{c.map.open} <Icon name="external" size={16} /></a>
      </div>
      <MapFacade />
      <div class="find__social">
        <span class="mono">{c.find.socialsLabel}</span>
        <ul role="list">
          {social.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener" aria-label={`${s.key === 'tiktok' ? 'TikTok' : s.key === 'facebook' ? 'Facebook' : 'Instagram'}: ${s.handle}`}><Icon name={s.key} size={20} /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .find { overflow: clip; }
  .find__bg {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 60% at 18% 30%, rgba(0, 208, 208, .14), transparent 70%),
      radial-gradient(40% 50% at 90% 90%, rgba(152, 196, 0, .08), transparent 70%),
      linear-gradient(180deg, #00152B, var(--navy) 60%);
  }
  .find__word { position: absolute; left: -2vw; bottom: -4vw; color: var(--aqua); opacity: .05; }
  .find__grid { display: grid; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .find__cta { display: grid; gap: 1.25rem; justify-items: start; }
  .find__title { max-width: 13ch; }
  .find__actions { display: grid; gap: .9rem; width: 100%; max-width: 560px; margin-top: .5rem; }
  .find__wa { --btn-h: 64px; font-size: 1.08rem; justify-content: flex-start; padding-right: 1.5rem; width: 100%; }
  .find__wa :global(.arrow) { margin-left: auto; }
  .find__wa .btn__glyph { width: 48px; height: 48px; }
  .find__calls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .find__call {
    display: flex; align-items: center; gap: .75rem; min-height: 64px; padding: .6rem 1rem; border-radius: var(--r-md);
    border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 60%, transparent);
    transition: border-color var(--d-base), background var(--d-base), transform var(--d-base) var(--ease-water);
  }
  .find__call:hover { border-color: var(--aqua); background: color-mix(in srgb, var(--aqua) 8%, var(--surface)); transform: translateY(-2px); }
  .find__call-icon { width: 40px; height: 40px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--aqua); background: color-mix(in srgb, var(--aqua) 12%, transparent); }
  .find__call-text { display: grid; line-height: 1.25; min-width: 0; }
  .find__call-text span { font-size: .8rem; color: var(--fg-muted); }
  .find__call-text b { font-weight: 600; font-size: .98rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .find .trust-note :global(svg) { color: var(--aqua); }

  .find__place { border-radius: var(--r-lg); border: 1px solid var(--line); padding: clamp(1.25rem, 3vw, 1.75rem); display: grid; gap: 1.25rem; box-shadow: var(--sh-card-dark); position: relative; }
  .find__place::before { content: ""; position: absolute; top: -1px; left: var(--r-lg); right: var(--r-lg); height: 1px; background: linear-gradient(90deg, transparent, var(--aqua), var(--lime), transparent); opacity: .8; }
  .find__place-head { display: grid; gap: .6rem; justify-items: start; }
  .find__addr { font-style: normal; display: grid; font-size: 1.05rem; line-height: 1.45; }
  .find__addr-label { color: var(--accent-text); margin-bottom: .2rem; }
  .find__social { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .find__social .mono { color: var(--fg-muted); }
  .find__social ul { list-style: none; display: flex; gap: .5rem; }
  .find__social a { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line); transition: background var(--d-base), border-color var(--d-base), color var(--d-base); }
  .find__social a:hover { background: #fff; color: var(--navy); border-color: #fff; }

  @media (min-width: 960px) {
    .find__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  @media (max-width: 480px) {
    .find__calls { grid-template-columns: 1fr; }
    .find__wa { font-size: 1rem; white-space: normal; text-align: left; }
  }
</style>
