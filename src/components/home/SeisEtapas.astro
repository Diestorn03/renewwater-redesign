---
/**
 * #etapas · SIG-2 · the six real layers of the Renew City tank (spec §6.3).
 *   <SeisEtapas />               home: pinned scrub + deterministic Canvas2D particles (desktop gate),
 *                                sticky tank + 6 cards (touch / <768px), static list (reduced motion / no JS)
 *   <SeisEtapas mode="static" /> About + /productos/renew-city: tank + list, hover highlighting, no pin, no canvas
 * The <ol> of stages is always in the DOM: it is the text equivalent of the tank and the canvas.
 * Logic: src/scripts/etapas/etapas.js (+ particles.js). Copy: src/i18n/areas/etapas.js.
 */
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/etapas.js';
import Icon from '../ui/Icon.astro';

interface Props { mode?: 'pin' | 'static' }
const { mode = 'pin' } = Astro.props;
const { t, lang, url, productUrl, asset } = useI18n(Astro);
const c = pick(copy, lang);
const pin = mode === 'pin';
const pad = (n: number) => String(n).padStart(2, '0');
const product = productUrl('renew-city');
const onProductPage = Astro.url.pathname.replace(/\/?$/, '/') === product;
const labHref = pin ? '#laboratorio' : url('analysis');
---
<section id="etapas" class:list={['et section', `et--${mode}`]} data-theme="dark" data-mode={mode} data-step="0" aria-labelledby="etapas-title">
  <div class="et__stage wrap">
    <header class="et__head">
      <p class="kicker">{c.kicker}</p>
      <h2 class="h2 et__title" id="etapas-title" data-split="lines">{c.title} <span class="accent">{c.titleAccent}</span></h2>
    </header>

    <div class="et__intro">
      <p class="et__lead">{c.lead}</p>
      {pin && <p class="et__hint mono" aria-hidden="true">{c.hint} <Icon name="chevron-down" size={16} /></p>}
    </div>

    {pin && (
      <a class="et__skip btn btn--text btn--sm" href="#soluciones">
        {c.skip} <Icon name="arrow" size={16} class="et__skip-ico" />
      </a>
    )}

    <div class="et__tankcol" data-reveal="up">
      <div class="et__tank" role="img" aria-label={c.tankLabel}>
        <div class="et__valve"><span class="et__lcd">RENEW WATER</span><span class="et__keys"><i></i><i></i><i></i></span></div>
        <div class="et__body">
          <span class="et__wordmark">RENEW WATER</span>
          <div class="et__window">
            <div class="et__inlet"></div>
            <div class="et__bands">
              {c.stages.map((s, i) => (
                <div class="et__band" data-i={i + 1} style={`--tile:url(${asset(`/img/tiles/tile-${s.key}.webp`)})`}></div>
              ))}
            </div>
            {pin && <canvas class="et__canvas"></canvas>}
            <div class="et__dry"></div>
            <div class="et__dim"></div>
            <i class="et__riser"></i>
            <i class="et__glass"></i>
          </div>
          {pin && (
            <ol class="et__callouts">
              {c.stages.map((s, i) => (
                <li class="et__callout" data-i={i + 1}><span class="num">{pad(i + 1)}</span><span class="et__callout-name">{s.name}</span><i></i></li>
              ))}
            </ol>
          )}
        </div>
        <div class="et__stream"></div>
      </div>
      {pin && <p class="disclaimer et__sim">{t.simulation}</p>}
    </div>

    {pin && (
      <div class="et__odo num" aria-hidden="true">
        <span class="et__odo-label mono">{c.step}</span>
        <span class="et__odo-digits"><span>0</span><span class="et__odo-win"><span class="et__odo-strip">{[0, 1, 2, 3, 4, 5, 6].map((d) => <span>{d}</span>)}</span></span></span>
        <span class="et__odo-total mono">/ 06</span>
      </div>
    )}

    <ol class="et__list">
      {c.stages.map((s, i) => (
        <li class="et__item" data-i={i + 1}>
          <span class="et__num num" aria-hidden="true">{pad(i + 1)}</span>
          <div class="et__text">
            <h3 class="et__name"><span class="sr-only">{c.step} {i + 1}: </span>{s.name} <span class="accent et__verb">{s.verb}</span></h3>
            <p class="et__ret mono">{s.chipsLabel ?? c.retains}</p>
            <ul class="et__chips" data-stagger="0.06">
              {s.chips.map((ch) => (
                <li class="et__chip" data-kind={ch.kind ?? 'none'}><i class="et__dot" aria-hidden="true"></i>{ch.label}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    {pin && (
      <div class="et__meters">
        <div class="et__rail" role="group" aria-label={c.steps}>
          <span class="et__rail-track" aria-hidden="true"><span class="et__rail-fill"></span></span>
          {c.stages.map((s, i) => (
            <button type="button" class="et__tick" data-i={i + 1} aria-label={`${c.goTo} ${i + 1}: ${s.name}`}>
              <i aria-hidden="true"></i><span class="num" aria-hidden="true">{pad(i + 1)}</span>
            </button>
          ))}
        </div>
        <div class="et__bar" aria-hidden="true">
          <span class="mono">{c.impurities}</span>
          <span class="mono et__pct">100%</span>
          <span class="et__bar-track"><span class="et__bar-fill"></span></span>
        </div>
      </div>
    )}

    <div class="et__out">
      <p class="et__out-lead mono"><Icon name="check-circle" size={18} grad /> {c.closingLead}</p>
      <p class="et__closing">{c.closing}</p>
      <div class="cta-row">
        {!onProductPage && (
          <a class="btn btn--primary" href={product} data-magnetic>{c.ctaProduct} <Icon name="arrow" size={18} class="arrow" /></a>
        )}
        <a class="btn btn--ghost" href={labHref}>{c.ctaLab}</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/etapas/etapas.js';
</script>

<style>
  /* ============ base = static layout (mode="static", reduced motion, no JS) ============ */
  .et { --tw: clamp(96px, 28vw, 250px); --th: clamp(320px, 56svh, 560px); overflow: clip; }
  .et--static { padding-block: calc(var(--section-y) * .6); }
  .et__stage {
    display: grid; column-gap: clamp(1rem, 4vw, 4rem);
    grid-template-columns: minmax(0, 32fr) minmax(0, 68fr);
    grid-template-areas: "head head" "intro intro" "skip skip" "tank list" "out out";
  }
  .et__head { grid-area: head; display: grid; gap: var(--s-4); }
  .et__title { max-width: 16ch; }
  .et__intro { grid-area: intro; margin-top: var(--s-4); }
  .et__lead { font-size: var(--fs-lead); line-height: 1.5; color: var(--fg-muted); max-width: 44ch; }
  .et__hint { display: none; }
  .et__skip { grid-area: skip; justify-self: start; margin-top: var(--s-3); gap: .4rem; padding-inline: 0; }
  .et__skip :global(.et__skip-ico) { transform: rotate(90deg); }
  .et__odo, .et__meters, .et__callouts, .et__sim { display: none; }

  /* the column stretches over the list row; the tank sticks inside it (so it stops before the closing block) */
  .et__tankcol { grid-area: tank; margin-top: var(--s-7); display: grid; justify-items: center; align-content: start; }
  .et__list { grid-area: list; list-style: none; margin-top: var(--s-7); display: grid; }
  .et__out { grid-area: out; margin-top: var(--s-8); display: grid; gap: var(--s-4); justify-items: start; }

  /* ---------- stage items (the text equivalent of the tank) ---------- */
  .et__item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 clamp(.75rem, 2vw, 1.5rem); align-items: start; padding-block: clamp(1rem, 2.4vw, 1.6rem); border-top: 1px solid var(--line); transition: opacity var(--d-base) var(--ease-water); }
  .et__item:last-child { border-bottom: 1px solid var(--line); }
  .et__num { font-size: clamp(1.6rem, 1.1rem + 2vw, 2.75rem); background: var(--grad-brand-v); -webkit-background-clip: text; background-clip: text; color: transparent; padding-top: .1em; }
  .et__text { display: grid; gap: var(--s-2); min-width: 0; }
  .et__name { font-size: var(--fs-h3); line-height: 1.15; letter-spacing: -.01em; font-weight: 600; }
  .et__verb { display: block; font-size: 1.25em; line-height: 1.1; margin-top: .1em; }
  .et__ret { color: var(--fg-muted); margin-top: var(--s-2); }
  .et__chips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .et__chip { display: inline-flex; align-items: center; gap: .5rem; min-height: 34px; padding: .3rem .85rem .3rem .7rem; border-radius: var(--r-pill); border: 1px solid var(--line); background: color-mix(in srgb, var(--current) 80%, transparent); font-size: .875rem; font-weight: 500; line-height: 1.2; }
  .et__dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--dot, var(--aqua)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot, var(--aqua)) 18%, transparent); }
  .et__chip[data-kind="sedimento"] { --dot: var(--c-sedimento); }
  .et__chip[data-kind="dureza"] { --dot: var(--c-dureza); }
  .et__chip[data-kind="cloro"] { --dot: var(--c-cloro); }
  .et__chip[data-kind="metal"] { --dot: var(--c-metal); }
  .et__chip[data-kind="quimico"] .et__dot { width: 10px; height: 9px; border-radius: 0; box-shadow: none; background: var(--c-quimico); clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .et__item.is-hover .et__name { color: #fff; }

  .et__out-lead { display: inline-flex; align-items: center; gap: .5rem; color: var(--accent-text); }
  .et__closing { font-size: clamp(1.35rem, 1rem + 1.4vw, 2.1rem); line-height: 1.25; letter-spacing: -.015em; font-weight: 500; max-width: 30ch; text-wrap: balance; }

  /* ============ the tank (CSS, scales with its own width via cqw) ============ */
  .et__tank { width: var(--tw); max-width: 100%; container-type: inline-size; position: sticky; top: calc(var(--header-h) + 16px); }
  .et__valve {
    position: relative; z-index: 2; width: 58%; height: 30cqw; margin-inline: auto;
    border-radius: 8cqw 8cqw 2.5cqw 2.5cqw;
    background: linear-gradient(90deg, rgba(255,255,255,.07), transparent 30% 70%, rgba(0,0,0,.35)), linear-gradient(180deg, #2b3844, #111a23 62%, #080d13);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 12px 24px -10px rgba(0,0,0,.7);
  }
  .et__valve::after { content: ""; position: absolute; left: 22%; right: 22%; top: 100%; height: 5cqw; background: linear-gradient(90deg, #121a22, #5b6975 42%, #1d2730 80%, #0e151c); }
  .et__lcd {
    position: absolute; left: 13%; right: 13%; top: 16%; height: 36%; border-radius: 1.6cqw;
    display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(120% 90% at 50% 0%, #0b4a4c, #042325 70%);
    box-shadow: inset 0 0 0 1px rgba(0,208,208,.45), inset 0 0 4cqw rgba(0,208,208,.28);
    font: 400 3.6cqw/1 var(--font-brand); letter-spacing: .14em; color: var(--aqua); text-shadow: 0 0 2cqw rgba(0,208,208,.9); white-space: nowrap;
  }
  .et__lcd::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(0,0,0,.22) 0 1px, transparent 1px 3px); }
  .et__keys { position: absolute; left: 20%; right: 20%; bottom: 14%; display: flex; justify-content: space-between; }
  .et__keys i { width: 7cqw; height: 3cqw; border-radius: 1cqw; background: linear-gradient(#4a5865, #27323c); box-shadow: inset 0 1px 0 rgba(255,255,255,.2); }
  .et__keys i:nth-child(2) { background: linear-gradient(#0a8d8d, #065e5e); }

  .et__body {
    position: relative; height: var(--th); margin-top: 5cqw;
    border-radius: 44% 44% 12% 12% / 8% 8% 4% 4%;
    background: linear-gradient(180deg, rgba(255,255,255,.35), transparent 8%, transparent 90%, rgba(0,0,0,.28)), var(--grad-steel);
    box-shadow: 0 50px 90px -40px rgba(0,0,0,.85), 0 0 0 1px rgba(255,255,255,.08);
  }
  .et__wordmark {
    position: absolute; right: 2.6%; top: 50%; transform: translateY(-50%) rotate(180deg); writing-mode: vertical-rl;
    font: 400 4.4cqw/1 var(--font-brand); letter-spacing: .32em; color: var(--navy); opacity: .12; white-space: nowrap; pointer-events: none;
  }
  .et__window {
    position: absolute; inset: 9% 12% 4.5%; overflow: hidden; background: #04182a;
    border-radius: 50% 50% 7cqw 7cqw / 20% 20% 3% 3%;
    box-shadow: 0 0 0 1.5px rgba(0,20,40,.55), 0 0 0 3px rgba(255,255,255,.35);
    --fy: 1;
  }
  .et__inlet {
    position: absolute; inset: 0 0 auto; height: 16%;
    background: radial-gradient(90% 70% at 35% 10%, rgba(120,230,240,.45), transparent 60%), linear-gradient(180deg, #0c6b86, #0a4260);
  }
  .et__inlet::before, .et__inlet::after { content: ""; position: absolute; inset: 0; transition: opacity var(--d-slow) var(--ease-water); }
  .et__inlet::before { background: linear-gradient(180deg, rgba(140,106,67,.35), var(--murk)); opacity: 0; }
  .et__inlet::after { background: linear-gradient(180deg, rgba(0,208,208,.35), var(--clear)); }
  .et.is-murky .et__inlet::before { opacity: 1; }
  .et.is-murky .et__inlet::after { opacity: 0; }
  .et__bands { position: absolute; inset: 16% 0 0; display: grid; grid-template-rows: repeat(6, minmax(0, 1fr)); }
  .et__band {
    position: relative; background: var(--tile) center / 40px 84px repeat;
    box-shadow: inset 0 8px 16px rgba(0,0,0,.35); border-top: 1px solid rgba(0,0,0,.6);
  }
  .et__band::after {
    content: ""; position: absolute; inset: 0; opacity: 0; transition: opacity var(--d-base) var(--ease-water);
    box-shadow: inset 0 0 0 1.5px rgba(0,208,208,.8), inset 0 0 22px rgba(0,208,208,.5);
    background: linear-gradient(90deg, rgba(0,208,208,.16), transparent 35% 65%, rgba(0,208,208,.16));
  }
  .et__band.is-active::after { opacity: 1; }
  .et__band.is-hover::after { opacity: .7; }
  .et__canvas { display: none; position: absolute; inset: 0; width: 100%; height: 100%; }
  /* not-yet-reached media: desaturated + darkened; its top edge is the water front (--fy 0 → 1, 1 = all reached) */
  .et__dry, .et__dim { position: absolute; left: 0; right: 0; top: 16%; height: 84%; transform: translate3d(0, calc(var(--fy) * 100%), 0); pointer-events: none; }
  .et__dry { background: hsl(0 0% 50% / .72); mix-blend-mode: saturation; }
  .et__dim { background: rgba(0, 11, 24, .5); }
  .et__dim::before { content: ""; position: absolute; inset: -1px 0 auto; height: 2px; background: var(--grad-brand); box-shadow: 0 0 14px 2px rgba(0,208,208,.6); }
  .et__dim::after { content: ""; position: absolute; left: 0; right: 0; bottom: 100%; height: 18%; background: linear-gradient(180deg, transparent, rgba(0,208,208,.18)); }
  .et__riser { position: absolute; top: 2%; bottom: 0; left: 63%; width: 4.2%; background: linear-gradient(90deg, #6f7c86, #f4f7f9 40%, #a4b0b9 70%, #56626c); box-shadow: 0 0 10px rgba(0,0,0,.45); }
  .et__glass { position: absolute; inset: 0; pointer-events: none; border-radius: inherit; background: linear-gradient(90deg, rgba(0,0,0,.5), rgba(255,255,255,.16) 8%, transparent 20% 76%, rgba(255,255,255,.07) 87%, rgba(0,0,0,.55)); }
  .et__stream { position: relative; width: 12cqw; height: clamp(40px, 8vh, 96px); margin-inline: auto; transform-origin: 50% 0; }
  .et__stream::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 6px; width: 4px; margin-left: -2px; border-radius: 4px; background: linear-gradient(180deg, #fff, var(--aqua) 30%, var(--mint) 80%, rgba(0,208,140,.2)); box-shadow: 0 0 16px 1px rgba(0,208,208,.85); }
  .et__stream::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 44cqw; height: 12px; margin-left: -22cqw; border-radius: 50%; background: radial-gradient(closest-side, rgba(0,208,208,.7), rgba(0,208,140,.18) 60%, transparent); }

  @media (max-width: 767px) {
    .et__item { grid-template-columns: 1fr; }
    .et__num { font-size: 2.25rem; margin-bottom: var(--s-2); }
    .et__name { font-size: 1.35rem; }
    .et__chip { font-size: .8125rem; }
    .et__out .cta-row { width: 100%; }
    .et__out .btn { flex: 1 1 100%; white-space: normal; }
  }
  @media (min-width: 768px) {
    .et__stage { grid-template-columns: minmax(0, 40fr) minmax(0, 60fr); }
    .et__band { background-size: 60px 126px; }
  }
  /* static layout on wide screens: list in two columns next to the sticky tank */
  @media (min-width: 1024px) {
    .et--static .et__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(1.5rem, 3vw, 3rem); align-content: start; }
    .et--static .et__item:nth-last-child(2) { border-bottom: 1px solid var(--line); }
  }

  /* ============ touch / <768px: sticky tank + 6 cards, an IntersectionObserver sets data-step ============ */
  @media (max-width: 767px) and (prefers-reduced-motion: no-preference), (pointer: coarse) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .et--pin { --tw: min(calc((100vw - 2 * var(--gutter) - 16px) * .32), 220px); --th: calc(60svh - .36 * var(--tw) - 56px); }
    :global(html.js) .et--pin .et__stage { grid-template-columns: minmax(0, 32fr) minmax(0, 68fr); column-gap: 16px; }
    :global(html.js) .et--pin .et__item { min-height: 70svh; align-content: center; opacity: .3; border: 0; }
    :global(html.js) .et--pin .et__item.is-active { opacity: 1; }
    :global(html.js) .et--pin .et__item:not(.is-active) .et__num { background: none; color: transparent; -webkit-text-stroke: 1px var(--haze); }
    :global(html.js) .et--pin :is(.et__dry, .et__dim) { transition: transform var(--d-slow) var(--ease-in-out); }
    :global(html.js) .et--pin .et__stream { transform: scaleY(0); transition: transform var(--d-slow) var(--ease-out); }
    :global(html.js) .et--pin.is-done .et__stream { transform: none; }
  }

  /* ============ desktop gate: pinned stage (100vh), panel = odometer + cross-faded items ============ */
  @media (min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .et--pin { --tw: clamp(180px, 16.5vw, 270px); --th: clamp(280px, 57vh, 640px); padding: 0; }
    :global(html.js) .et--pin .et__stage {
      position: relative; height: 100vh; min-height: 560px;
      padding-block: calc(var(--header-h) + 3vh) 5vh;
      grid-template-columns: calc(var(--tw) + clamp(56px, 13vw, 220px)) auto minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
      grid-template-areas: "tank head head" "tank odo stage" "tank meters meters";
      column-gap: clamp(1.5rem, 3.4vw, 4rem);
    }
    :global(html.js) .et--pin .et__title { font-size: min(var(--fs-h2), 6.4vh); max-width: 18ch; }
    :global(html.js) .et--pin .et__tankcol { margin: 0; align-self: center; justify-items: end; }
    :global(html.js) .et--pin .et__tank { position: relative; top: auto; }
    :global(html.js) .et--pin .et__sim { display: block; justify-self: start; white-space: nowrap; margin-top: -3.5vh; }
    :global(html.js) .et--pin .et__callouts { display: grid; }
    :global(html.js) .et--pin .et__canvas { display: block; }
    :global(html.js) .et--pin .et__band { background-size: 80px 168px; cursor: pointer; }

    /* stacked panel cell: intro / item 1..6 / out, cross-faded (opacity + translate only; all stay in the a11y tree) */
    :global(html.js) .et--pin :is(.et__intro, .et__list, .et__out) { grid-area: stage; align-self: center; margin: 0; }
    :global(html.js) .et--pin .et__out { grid-column: odo-start / stage-end; }
    :global(html.js) .et--pin .et__item { grid-area: 1 / 1; border: 0; padding: 0; grid-template-columns: 1fr; }
    :global(html.js) .et--pin .et__num { display: none; }
    :global(html.js) .et--pin .et__name { font-size: clamp(1.75rem, .9rem + 1.9vw, 3rem); letter-spacing: -.025em; }
    :global(html.js) .et--pin :is(.et__intro, .et__item, .et__out) {
      opacity: 0; transform: translate3d(0, 24px, 0); pointer-events: none;
      transition: opacity .45s var(--ease-water), transform .8s var(--ease-out);
    }
    :global(html.js) .et--pin[data-step="0"] .et__intro,
    :global(html.js) .et--pin .et__item.is-active,
    :global(html.js) .et--pin[data-step="7"] .et__out { opacity: 1; transform: none; pointer-events: auto; transition-delay: .1s; }
    :global(html.js) .et--pin .et__hint { display: inline-flex; align-items: center; gap: .5rem; margin-top: var(--s-5); color: var(--accent-text); }
    :global(html.js) .et--pin[data-step="0"] .et__hint :global(svg) { animation: et-bob 1.8s var(--ease-in-out) infinite; }
    :global(html.js) .et--pin .et__skip { position: absolute; right: 0; top: calc(var(--header-h) + 3vh - 12px); margin: 0; z-index: 3; color: var(--fg-muted); }
    :global(html.js) .et--pin .et__skip:hover { color: var(--aqua); }
    :global(html.js) .et--pin .et__closing { max-width: 26ch; }
    :global(html.js) .et--pin .et__stream { transform: scaleY(0); }
    /* etapas.js writes these transforms on every scrub frame: each one on its own GPU layer, so the pinned stage
       (tank gradients, shadows, text) is never repainted while scrolling */
    :global(html.js) .et--pin :is(.et__dry, .et__dim, .et__rail-fill, .et__bar-fill, .et__stream) { will-change: transform; }

    :global(html.js) .et--pin .et__odo { grid-area: odo; align-self: center; display: grid; grid-template-columns: auto auto; align-items: end; column-gap: .6rem; transition: opacity .5s var(--ease-water); }
    :global(html.js) .et--pin[data-step="0"] .et__odo { opacity: .35; }
    :global(html.js) .et--pin[data-step="7"] .et__odo { opacity: 0; }
    .et__odo-label { grid-column: 1 / -1; color: var(--fg-muted); margin-bottom: .6rem; }
