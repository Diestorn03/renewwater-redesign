---
// Stage configuration switch (Ósmosis Inversa 3/5/6/7, Línea Clásica/Económica 2/3/4). Native radios; the lit cartridges and
// the visible description are pure CSS (:has), scripts/products/detail.js only rewrites the WhatsApp quote text.
interface Props {
  legend: string;
  options: { n: number; label: string; text: string; meta?: string }[];
  slots: number;                 // cartridges drawn in the diagram
  initial?: number;
  quoteTitles?: Record<number, string>; // product name per option for the WhatsApp message
  note?: string;
}
const { legend, options, slots, initial = options[0].n, quoteTitles = {}, note } = Astro.props;
---
<fieldset class="cfg">
  <legend class="cfg__legend">{legend}</legend>
  <div class="cfg__chips">
    {options.map((o) => (
      <label class="chip cfg__chip">
        <input type="radio" name="config" value={o.n} checked={o.n === initial} data-quote={quoteTitles[o.n]} />
        <span class="num cfg__n">{o.n}</span>{o.label}
      </label>
    ))}
  </div>
  <div class="cfg__panel">
    <div class="cfg__viz" aria-hidden="true">
      {Array.from({ length: slots }, (_, i) => <span class="cfg__cart" style={`--i:${i}`}></span>)}
    </div>
    <div class="cfg__texts">
      {options.map((o) => (
        <div class="cfg__text" data-n={o.n}>
          <p class="cfg__title"><span class="num">{o.n}</span> {o.label}</p>
          <p>{o.text}</p>
          {o.meta && <p class="cfg__meta mono">{o.meta}</p>}
        </div>
      ))}
    </div>
  </div>
  {note && <p class="cfg__note">{note}</p>}
</fieldset>

<style>
  .cfg { border: 1px solid var(--line); border-radius: var(--r-lg); padding: clamp(1.1rem, 2.5vw, 1.6rem); margin: 0; min-width: 0; background: var(--white); box-shadow: var(--sh-card-light); }
  .cfg__legend { float: left; width: 100%; font-weight: 600; font-size: 1.05rem; margin-bottom: .9rem; padding: 0; }
  .cfg__chips { clear: both; display: flex; flex-wrap: wrap; gap: .5rem; }
  .cfg__chip { gap: .45rem; padding-inline: .9rem 1.1rem; }
  .cfg__n { font-size: 1.05rem; color: var(--aqua-ink); }
  .cfg__panel { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.25rem; align-items: center; margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px dashed var(--line); }
  .cfg__viz { display: flex; gap: 5px; align-items: flex-end; height: 76px; }
  .cfg__cart {
    width: clamp(12px, 2.4vw, 16px); height: calc(52% + var(--i) * 6%); border-radius: 6px 6px 4px 4px;
    border: 1.5px solid #BFD9DA; background: var(--foam);
    transition: background var(--d-base) var(--ease-water), border-color var(--d-base), transform var(--d-base) var(--ease-out);
    transition-delay: calc(var(--i) * 45ms);
  }
  .cfg__text { display: none; }
  .cfg__title { font-weight: 600; margin-bottom: .2rem; }
  .cfg__title .num { color: var(--aqua-ink); }
  .cfg__text p:not(.cfg__title) { color: var(--slate); font-size: .98rem; line-height: 1.5; }
  .cfg__meta { margin-top: .5rem; color: var(--aqua-ink) !important; }
  .cfg__note { margin-top: 1rem; font-size: var(--fs-small); color: var(--slate); }

  /* selection → description + lit cartridges, no JS needed */
  .cfg:has(input[value="2"]:checked) .cfg__text[data-n="2"],
  .cfg:has(input[value="3"]:checked) .cfg__text[data-n="3"],
  .cfg:has(input[value="4"]:checked) .cfg__text[data-n="4"],
  .cfg:has(input[value="5"]:checked) .cfg__text[data-n="5"],
  .cfg:has(input[value="6"]:checked) .cfg__text[data-n="6"],
  .cfg:has(input[value="7"]:checked) .cfg__text[data-n="7"] { display: block; animation: cfg-in .45s var(--ease-out); }
  .cfg:has(input[value="2"]:checked) .cfg__cart:nth-child(-n + 2),
  .cfg:has(input[value="3"]:checked) .cfg__cart:nth-child(-n + 3),
  .cfg:has(input[value="4"]:checked) .cfg__cart:nth-child(-n + 4),
  .cfg:has(input[value="5"]:checked) .cfg__cart:nth-child(-n + 5),
  .cfg:has(input[value="6"]:checked) .cfg__cart:nth-child(-n + 6),
  .cfg:has(input[value="7"]:checked) .cfg__cart:nth-child(-n + 7) {
    background: var(--grad-brand-v); border-color: transparent; box-shadow: 0 6px 14px -6px rgba(0, 208, 208, .7); transform: translateY(-3px);
  }
  @keyframes cfg-in { from { opacity: 0; transform: translateY(6px); } }
  @media (max-width: 420px) { .cfg__panel { grid-template-columns: 1fr; } }
</style>
