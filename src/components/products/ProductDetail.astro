---
// Product detail, shared by /productos/[slug] and /en/products/[slug].
// Sticky left column (stage + flyers + quote card) on desktop; on phones the same blocks reflow and a quote bar sticks to the bottom.
import Icon from '../ui/Icon.astro';
import ProductCard from './ProductCard.astro';
import ConfigToggle from './ConfigToggle.astro';
import SeisEtapas from '../home/SeisEtapas.astro';
import copy from '../../i18n/areas/products.js';
import { pick, useI18n } from '../../i18n/index.js';
import { buildWa, phoneFor } from '../../data/site.js';
import { badge, taglineParts, related, splitHighlight } from '../../scripts/products/meta.js';

interface Props { product: any }
const { product: p } = Astro.props;
const { t, lang, url, asset } = useI18n(Astro);
const c = pick(copy, lang);
const d = c.detail;
const title = p.title[lang];
const tag = badge(p, lang, c.stages);
const [pre, acc, post] = taglineParts(p, lang);
const kicker = p.line?.[lang] ?? p.categories.filter((k) => k !== 'linea').map((k) => c.filters[k]).join(' · ');
const quote = (name) => buildWa({ text: t.wa.quote(name), ref: 'web-producto' });
const phone = phoneFor(lang);
const flyers = p.flyers.map((src) => ({ src, sm: src.replace('.webp', '-sm.webp') }));
const [w, h] = p.cutoutSize;
const paragraphs = p.description[lang].split('\n\n');
const trust = [
  { icon: 'coin', text: t.trust.down },
  { icon: 'wrench', text: t.trust.install },
  { icon: 'flask', text: t.trust.analysis },
  { icon: 'shield', text: t.trust.wqa },
];

// configuration switch: osmosis configs (3/5/6/7) or the line variants (2/3/4)
let cfg = null;
if (p.configs) {
  const ns = Object.keys(p.configs).map(Number);
  cfg = {
    options: ns.map((n) => ({ n, label: c.stages, text: p.configs[n][lang] })),
    slots: Math.max(...ns), initial: ns[1] ?? ns[0],
    quoteTitles: Object.fromEntries(ns.map((n) => [n, d.config.quote(title, n)])),
    note: d.config.note,
  };
} else if (p.variants) {
  cfg = {
    options: p.variants.map((v) => ({ n: v.stages, label: c.stages, text: v.idealFor[lang], meta: `${d.size}: ${v.size}` })),
    slots: Math.max(...p.variants.map((v) => v.stages)), initial: p.variants[0].stages,
    quoteTitles: Object.fromEntries(p.variants.map((v) => [v.stages, `${title} · ${v.name[lang]}`])),
  };
}
const initialTitle = cfg ? cfg.quoteTitles[cfg.initial] : title;
const rel = related(p);
---
<section class="section pd" data-theme="light" data-quote-tpl={t.wa.quote('{name}')} aria-labelledby="pd-title">
  <div class="wrap">
    <nav class="pd__crumbs" aria-label={d.breadcrumb}>
      <ol>
        <li><a href={url('home')}>{t.nav.home}</a></li>
        <li><a href={url('products')}>{t.nav.products}</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="pd__grid">
      <div class="pd__aside">
        <div class="pd__media" transition:name={`prod-${p.slug}`}>
          <img src={asset(p.cutout)} width={w} height={h} alt={p.alt[lang]} loading="eager" fetchpriority="high" decoding="async" />
        </div>

        <div class="pd__flyers">
          <p class="mono pd__label">{d.flyers}</p>
          <ul class="pd__thumbs" role="list">
            {flyers.map((f, i) => (
              <li>
                <a class="pd__thumb" href={asset(f.src)} data-lightbox={`prod-${p.slug}`} data-caption={d.flyerCaption(title)} aria-label={d.openFlyer(title, i + 1)}>
                  <img src={asset(f.sm)} width="560" height="725" alt="" loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn--text pd__download" href={asset(p.flyers[0])} download={`renew-water-${p.slug}.webp`}>
            <Icon name="download" size={18} />{d.download}
          </a>
        </div>

        <div class="pd__cta" id="pd-cta">
          <p class="pd__cta-text">{d.ctaText}</p>
          <a class="btn btn--primary btn--wa pd__cta-btn" href={quote(initialTitle)} target="_blank" rel="noopener" data-quote-link data-magnetic>
            <span class="btn__glyph"><Icon name="whatsapp" size={22} /></span>{d.cta}
          </a>
          <p class="trust-note"><Icon name="clock" size={16} />{t.cta.trust}</p>
          <a class="pd__call" href={`tel:${phone.tel}`}><Icon name="phone" size={16} />{t.cta.call} {phone.display}</a>
        </div>
      </div>

      <div class="pd__info">
        <p class="kicker">{kicker}</p>
        <h1 id="pd-title" class="pd__title" data-split="lines">{title}</h1>
        {tag && <span class="badge-num pd__badge">{tag}</span>}
        <p class="pd__tagline">{pre}{acc && <span class="accent">{acc}</span>}{post}</p>
        <div class="pd__desc stack">{paragraphs.map((x) => <p>{x}</p>)}</div>

        {cfg && (
          <div data-reveal="up">
            <ConfigToggle legend={p.configs ? d.config.legend : d.variants} {...cfg} />
          </div>
        )}

        <div class="pd__block" data-reveal="up">
          <h2 class="pd__h"><Icon name="house" size={22} grad />{d.ideal}</h2>
          <p>{p.idealFor[lang]}</p>
        </div>

        {p.highlights[lang].length > 0 && (
          <div class="pd__block" data-reveal="up">
            <h2 class="pd__h"><Icon name="sparkle" size={22} grad />{d.highlights}</h2>
            <ul class="pd__checks" role="list">
              {p.highlights[lang].map((hl) => {
                const [label, text] = splitHighlight(hl);
                return <li><span class="pd__check" aria-hidden="true"><Icon name="check" size={16} strokeWidth={2.4} /></span><span>{label && <strong>{label}: </strong>}{text}</span></li>;
              })}
            </ul>
          </div>
        )}

        {p.closing && <p class="pd__closing" data-reveal="up">{p.closing[lang]}</p>}

        <ul class="pd__trust" role="list" data-stagger=".06">
          {trust.map((x) => <li><Icon name={x.icon} size={22} grad /><span>{x.text}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

{p.slug === 'renew-city' && <SeisEtapas mode="static" />}

<section class="section pd-related" data-theme={p.slug === 'renew-city' ? 'light' : 'dark'} aria-labelledby="pd-related-title">
  <div class="wrap">
    <div class="pd-related__head">
      <h2 id="pd-related-title" class="h2" data-split="lines">{d.related} <span class="accent">{d.relatedAccent}</span></h2>
      <a class="btn btn--ghost" href={url('products')}>{d.allProducts}<Icon name="arrow" size={18} class="arrow" /></a>
    </div>
    <div class="pd-related__grid" data-stagger=".08">
      {rel.map((q) => <ProductCard product={q} />)}
    </div>
  </div>
</section>

<div class="pd-bar" id="pd-bar" data-theme="dark" aria-hidden="true">
  <a class="btn btn--primary pd-bar__quote" href={quote(initialTitle)} target="_blank" rel="noopener" data-quote-link tabindex="-1">
    <Icon name="whatsapp" size={20} /><span class="pd-bar__label">{d.stickyQuote(title)}</span>
  </a>
  <a class="pd-bar__call" href={`tel:${phone.tel}`} aria-label={d.callAria} tabindex="-1"><Icon name="phone" size={20} /></a>
</div>

<script>
  import '../../scripts/products/detail.js';
</script>

<style>
  .pd { padding-top: calc(var(--header-h) + clamp(20px, 3vw, 40px)); }
  .pd__crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .88rem; color: var(--slate); }
  .pd__crumbs li { display: inline-flex; align-items: center; gap: .5rem; }
  .pd__crumbs li + li::before { content: ""; width: 6px; height: 6px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); opacity: .6; }
  .pd__crumbs a { display: inline-block; padding: .7rem 0; color: var(--aqua-ink); }
  .pd__crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .pd__crumbs [aria-current] { color: var(--navy); font-weight: 500; }

  .pd__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 5.5rem); margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: start; }
  .pd__aside { position: sticky; top: calc(var(--header-h) + 20px); display: grid; gap: 1rem; }

  .pd__media {
    position: relative; height: clamp(280px, 40vh, 460px); border-radius: var(--r-lg); overflow: hidden; isolation: isolate;
    background:
      radial-gradient(50% 42% at 50% 54%, rgba(0, 208, 208, .34), rgba(0, 208, 208, 0) 72%),
      radial-gradient(90% 60% at 50% 110%, rgba(152, 196, 0, .2), rgba(152, 196, 0, 0) 70%),
      linear-gradient(180deg, #EEF9F6 0%, var(--mist) 100%);
    box-shadow: inset 0 1px 0 #fff, 0 30px 60px -36px rgba(0, 118, 122, .5);
  }
  .pd__media::after { content: ""; position: absolute; left: 20%; right: 20%; bottom: 5%; height: 6%; z-index: -1; background: radial-gradient(closest-side, rgba(0, 28, 56, .25), rgba(0, 28, 56, 0)); }
  .pd__media img { position: absolute; inset: 6% 8% 7%; width: 84%; height: 87%; object-fit: contain; object-position: 50% 100%; mix-blend-mode: multiply; }

  .pd__flyers { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
  .pd__label { flex-basis: 100%; color: var(--slate); }
  .pd__thumbs { margin-right: auto; }
  .pd__thumbs { list-style: none; display: flex; gap: .6rem; }
  .pd__thumb { display: block; width: 64px; border-radius: var(--r-sm); overflow: hidden; border: 1px solid var(--line); background: #fff; box-shadow: 0 8px 18px -12px rgba(0, 28, 56, .4); transition: transform var(--d-base) var(--ease-water), border-color var(--d-base); }
  .pd__thumb:hover { transform: translateY(-3px); border-color: var(--aqua-ink); }
  .pd__thumb img { width: 100%; height: auto; }
  .pd__download { gap: .45rem; font-weight: 600; font-size: .92rem; }

  .pd__cta { display: grid; gap: .7rem; padding: 1.25rem; border-radius: var(--r-lg); background: var(--navy); color: var(--foam-text); box-shadow: var(--sh-float); position: relative; overflow: hidden; }
  .pd__cta::before { content: ""; position: absolute; inset: 0 0 auto; height: 2px; background: var(--grad-brand); }
  .pd__cta-text { color: var(--haze); font-size: .95rem; }
  .pd__cta-btn { width: 100%; justify-content: flex-start; white-space: normal; text-align: left; }
  .pd__cta .trust-note { color: var(--haze); flex-wrap: nowrap; align-items: flex-start; }
  .pd__cta .trust-note :global(svg) { flex: none; margin-top: .2em; }
  .pd__call { display: inline-flex; align-items: center; gap: .45rem; min-height: 44px; color: var(--aqua); font-weight: 600; font-size: .92rem; }

  .pd__info { display: grid; gap: 1.4rem; align-content: start; }
  .pd__info > * { min-width: 0; }
  .pd__title { font-size: clamp(2.6rem, 1.4rem + 4.2vw, 5.25rem); line-height: .96; letter-spacing: -.035em; }
  .pd__badge { justify-self: start; margin-top: -.3rem; }
  .pd__tagline { font-size: clamp(1.3rem, 1rem + 1vw, 1.8rem); line-height: 1.3; letter-spacing: -.01em; font-weight: 500; color: var(--navy); max-width: 30ch; }
  .pd__tagline .accent { background: var(--grad-ink); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .pd__desc { color: var(--slate); max-width: var(--measure); gap: 1rem; }
  .pd__block { display: grid; gap: .7rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .pd__h { display: flex; align-items: center; gap: .6rem; font-size: 1.15rem; letter-spacing: -.01em; }
  .pd__block > p { color: var(--slate); max-width: var(--measure); }
  .pd__checks { list-style: none; display: grid; gap: .8rem; }
  .pd__checks li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: .75rem; align-items: start; line-height: 1.5; }
  .pd__checks strong { color: var(--navy); font-weight: 600; }
  .pd__check { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--grad-brand); color: var(--navy); margin-top: -.05rem; }
  .pd__closing { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.35rem, 1rem + 1.2vw, 1.9rem); line-height: 1.3; color: var(--navy); padding-left: 1.2rem; border-left: 2px solid; border-image: var(--grad-ink) 1; }
  .pd__trust { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .pd__trust li { display: grid; gap: .5rem; justify-items: start; padding: 1rem; border-radius: var(--r-md); background: var(--white); border: 1px solid var(--line); font-size: .9rem; font-weight: 600; line-height: 1.25; }

  .pd-related__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .pd-related__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }

  /* phones: bottom quote bar, drawn over the site's action bar while it is shown */
  .pd-bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: calc(var(--z-fab) + 2);
    display: none; gap: .5rem; align-items: center;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); min-height: calc(var(--bar-h) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--abyss) 94%, transparent); border-top: 1px solid rgba(143, 179, 196, .18);
    transform: translateY(110%); transition: transform var(--d-base) var(--ease-water);
  }
  .pd-bar.is-on { transform: none; }
  .pd-bar__quote { flex: 1; min-width: 0; }
  .pd-bar__label { overflow: hidden; text-overflow: ellipsis; }
  .pd-bar__call { width: 48px; height: 48px; flex: none; display: grid; place-items: center; border-radius: 50%; color: var(--foam-text); border: 1px solid rgba(143, 179, 196, .35); }

  /* short laptop screens: the sticky column (photo, flyers, CTA card) must fit under the header */
  @media (min-width: 901px) and (max-height: 800px) { .pd__media { height: clamp(160px, 100vh - 500px, 34vh); } }
  @media (max-width: 1100px) { .pd__trust { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .pd__grid { display: flex; flex-direction: column; align-items: stretch; gap: 1.5rem; }
    .pd__aside { display: contents; }
    .pd__media { order: 1; height: clamp(300px, 88vw, 440px); }
    .pd__info { order: 2; }
    .pd__flyers { order: 3; }
    .pd__cta { order: 4; }
    .pd-related__grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  }
  @media (max-width: 767px) { .pd-bar { display: flex; } }
</style>
