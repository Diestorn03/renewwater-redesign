---
/**
 * Bottom action bar (< 768px): 2/3 WhatsApp pill, 1/3 call (number by language). chrome.js toggles .is-shown
 * after the hero, hides it over #laboratorio / #encuentranos and while the menu is open.
 */
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/chrome.js';
import { buildWa, phoneFor } from '../../data/site.js';
import Icon from '../ui/Icon.astro';
interface Props { waRef?: string }
const { waRef = 'web-fab' } = Astro.props;
const { t, o, lang } = useI18n(Astro);
const c = pick(copy, lang);
const phone = phoneFor(lang);
---
<div class="abar" data-theme="dark">
  <a class="abar__wa" href={buildWa({ text: o.floatingButton.whatsappMessage, ref: waRef })} target="_blank" rel="noopener">
    <Icon name="whatsapp" size={22} /><span>{c.bar}</span>
  </a>
  <a class="abar__call" href={`tel:${phone.tel}`} aria-label={`${t.cta.call} ${phone.display}`}>
    <Icon name="phone" size={20} /><span>{t.cta.call}</span>
  </a>
</div>

<style>
  :global(body:has(#pd-bar.is-on)) .abar { visibility: hidden; }
  .abar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--z-fab);
    display: grid; grid-template-columns: 2fr 1fr; gap: 8px; align-items: center;
    height: calc(var(--bar-h) + env(safe-area-inset-bottom)); padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--abyss) 94%, transparent); border-top: 1px solid var(--line);
    view-transition-name: rw-bar;
    transition: transform .4s var(--ease-water), opacity .3s var(--ease-water);
  }
  @media (pointer: fine) { .abar { background: color-mix(in srgb, var(--abyss) 82%, transparent); -webkit-backdrop-filter: blur(14px) saturate(140%); backdrop-filter: blur(14px) saturate(140%); } }
  @media (min-width: 768px) { .abar { display: none; } }
  .abar a { display: flex; align-items: center; justify-content: center; gap: .5rem; height: 48px; border-radius: var(--r-pill); font-weight: 600; font-size: .92rem; white-space: nowrap; }
  .abar__wa { background: var(--grad-brand); color: var(--navy); box-shadow: 0 10px 24px -12px rgba(0, 208, 208, .7); }
  .abar__call { color: var(--fg); border: 1px solid color-mix(in srgb, var(--aqua) 45%, transparent); }
  .abar a:active { transform: scale(.97); }
  :global(.js) .abar:not(.is-shown) { transform: translateY(110%); opacity: 0; pointer-events: none; }
  @media (max-width: 379px) { .abar a { font-size: .84rem; gap: .35rem; } }
</style>
