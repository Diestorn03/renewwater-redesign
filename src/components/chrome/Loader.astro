---
/**
 * Loader "El Trazo": first visit per session only, never with calm motion (footer switch), never without JS.
 * It covers the page while it gets ready and only leaves when the engine says the page is settled ('rw:ready':
 * fonts, images, ScrollTrigger measurements, the hero's split title and shader), so the visitor never sees the
 * page assembling itself or stuttering.
 * Every move is a transform or an opacity change, which the browser runs on the compositor: the loader stays fluid
 * while the main thread is busy booting the page behind it.
 *   entrance (~1 s, always played in full): the mark fills up like water, the wordmark slides in, then a drop drips
 *   in a loop while waiting (the page behind cannot be scrolled meanwhile; the 5 s cap only counts visible time)
 *   exit: the stage lifts and fades, a last drop falls toward the hero, the overlay slides up while its panel
 *         counter-slides down (the bottom edge sweeps up the screen with the picture held still)
 * The inline script removes #loader when it must not run, so introGate() resolves at once. Otherwise it dispatches
 * 'rw:loader-exit' when the exit starts and 'rw:loader-done' at the end (detail {x, y} = where the drop lands).
 */
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/chrome.js';
import LogoMark from './LogoMark.astro';
const { lang, asset } = useI18n(Astro);
const c = pick(copy, lang);
---
<div id="loader" class="loader" data-theme="dark">
  <div class="loader__panel">
    <div class="loader__stage" aria-hidden="true">
      <span class="loader__mark"><span class="loader__mark-in"><LogoMark size="clamp(84px, 11vw, 124px)" weight={1.1} /></span></span>
      <span class="loader__wordwin"><span class="loader__word" style={`--wm:url(${asset('/img/brand/logo.webp')})`}></span></span>
      <span class="loader__drop"></span>
    </div>
    <button class="loader__skip" type="button">{c.skipIntro}<span aria-hidden="true">→</span></button>
  </div>
</div>
<script is:inline>
  (function () {
    var l = document.getElementById('loader');
    if (!l) return;
    var root = document.documentElement, show = false;
    var reduced = root.classList.contains('rw-calm'); // footer motion switch (Base.astro sets it from localStorage)
    try { show = !reduced && !window.__rwIntro && !sessionStorage.getItem('rw-intro'); sessionStorage.setItem('rw-intro', '1'); }
    catch (e) { show = !reduced && !window.__rwIntro; }
    window.__rwIntro = 1;
    if (!show) { l.remove(); return; }
    root.classList.add('rw-intro');
    var leaving = false, finished = false, ready = false, entered = false;
    // the page behind must not scroll while it is covered (the scenes are built for the top of the page)
    var hold = { capture: true, passive: false };
    // capture on window runs first: stopping it also keeps the event from Lenis (smooth scroll), which ignores preventDefault
    function stop(e) { e.preventDefault(); e.stopImmediatePropagation(); }
    window.addEventListener('wheel', stop, hold);
    window.addEventListener('touchmove', stop, hold);
    var scrollKeys = { ' ': 1, PageUp: 1, PageDown: 1, Home: 1, End: 1, ArrowUp: 1, ArrowDown: 1 };
    function done() {
      if (finished) return; finished = true;
      l.classList.add('is-done');
      root.classList.remove('rw-intro');
      document.removeEventListener('keydown', onKey, true);
      window.removeEventListener('wheel', stop, hold); // released only now: input queued during the loader must not scroll the reveal
      window.removeEventListener('touchmove', stop, hold);
      document.dispatchEvent(new CustomEvent('rw:loader-done', { detail: { x: innerWidth / 2, y: innerHeight * .72 } }));
      setTimeout(function () { l.remove(); }, 60);
    }
    function leave(fast) {
      if (leaving) return; leaving = true;
      l.classList.add('is-exit');
      if (fast) l.classList.add('is-skip');
      document.dispatchEvent(new CustomEvent('rw:loader-exit'));
      setTimeout(done, fast ? 700 : 1200); // in case animationend never arrives
    }
    function onKey(e) {
      if (e.key === 'Escape') { leave(true); return; }
      if (!finished && scrollKeys[e.key] && !(e.key === ' ' && e.target.closest && e.target.closest('button'))) e.preventDefault();
    }
    // leave once the page is ready AND the entrance (mark + wordmark) has played; the cap only counts visible time
    function go() { if (ready && entered) leave(); }
    document.addEventListener('rw:ready', function () { ready = true; go(); }, { once: true });
    setTimeout(function cap() {
      if (!document.hidden) leave();
      else document.addEventListener('visibilitychange', function () { setTimeout(leave, 1500); }, { once: true });
    }, 5000);
    l.addEventListener('animationend', function (e) {
      if (e.target === l) done();
      else if (e.target.classList && e.target.classList.contains('loader__word')) { entered = true; go(); }
    });
    l.querySelector('.loader__skip').addEventListener('click', function () { leave(true); });
    document.addEventListener('keydown', onKey, true);
  })();
</script>

<style>
  .loader { display: none; }
  :global(html.rw-intro) .loader { position: fixed; inset: 0; z-index: var(--z-loader); display: block; overflow: hidden; will-change: transform; touch-action: none; }
  .loader__panel {
    position: absolute; inset: 0; display: grid; place-items: center; will-change: transform;
    background: radial-gradient(70% 55% at 50% 45%, #03203B 0%, var(--abyss) 70%);
    color: var(--fg);
  }

  /* ---------- entrance ---------- */
  .loader__stage { position: relative; display: grid; justify-items: center; gap: clamp(18px, 2.4vw, 26px); }
  /* windows: the outer box slides in while its content counter-slides, so the content stays put and only the edge moves */
  .loader__mark, .loader__mark-in, .loader__wordwin, .loader__word { display: block; will-change: transform; }
  .loader__mark { position: relative; overflow: hidden; transform: translate3d(0, 100%, 0); animation: ld-in .9s cubic-bezier(.33, 1, .68, 1) .08s forwards; }
  .loader__mark-in { transform: translate3d(0, -100%, 0); animation: ld-in .9s cubic-bezier(.33, 1, .68, 1) .08s forwards; }
  /* the rising water line on the mark's edge */
  .loader__mark::after {
    content: ""; position: absolute; left: -10%; right: -10%; top: 0; height: 2px; z-index: 1;
    background: var(--grad-brand); box-shadow: 0 0 12px rgba(0, 208, 208, .85);
    animation: ld-fade .35s ease-out .9s forwards;
  }
  .loader__wordwin { overflow: hidden; transform: translate3d(-101%, 0, 0); animation: ld-in .55s cubic-bezier(.33, 1, .68, 1) .5s forwards; }
  .loader__word {
    height: clamp(16px, 2vw, 22px); aspect-ratio: 715 / 71; background: var(--grad-brand);
    -webkit-mask: var(--wm) 95.59% 50.56% / 131.75% 225.35% no-repeat;
    mask: var(--wm) 95.59% 50.56% / 131.75% 225.35% no-repeat;
    transform: translate3d(101%, 0, 0); animation: ld-in .55s cubic-bezier(.33, 1, .68, 1) .5s forwards;
  }
  @keyframes ld-in { to { transform: none; } }
  @keyframes ld-fade { to { opacity: 0; } }

  /* ---------- waiting: a drop drips under the wordmark until the page is ready ---------- */
  .loader__drop { position: relative; width: 10px; height: 13px; margin-top: -4px; opacity: 0; will-change: transform, opacity; animation: ld-drip 1.15s cubic-bezier(.55, 0, 1, .45) 1.1s infinite; }
  .loader__drop::before {
    content: ""; position: absolute; inset: 0;
    background: var(--grad-brand-v); border-radius: 50% 50% 50% 50% / 62% 62% 38% 38%;
    clip-path: polygon(50% 0, 100% 58%, 92% 82%, 72% 97%, 50% 100%, 28% 97%, 8% 82%, 0 58%);
  }
  @keyframes ld-drip {
    0% { opacity: 0; transform: translate3d(0, -2px, 0) scale(.5); }
    18% { opacity: 1; transform: translate3d(0, 0, 0) scale(1, .85); }
    75% { opacity: .9; transform: translate3d(0, 4.5vh, 0) scale(.95, 1.15); }
    100% { opacity: 0; transform: translate3d(0, 6vh, 0) scale(.9, 1.2); }
  }

  /* ---------- exit ---------- */
  .loader.is-exit .loader__stage { animation: ld-stage-out .4s cubic-bezier(.65, 0, .35, 1) forwards; }
  .loader.is-exit .loader__drop { animation: ld-fall .42s cubic-bezier(.55, 0, 1, .45) forwards; }
  .loader.is-exit { animation: ld-up .62s cubic-bezier(.65, 0, .35, 1) .16s forwards; }
  .loader.is-exit .loader__panel { animation: ld-down .62s cubic-bezier(.65, 0, .35, 1) .16s forwards; }
  .loader.is-skip, .loader.is-skip .loader__panel { animation-duration: .34s; animation-delay: 0s; }
  @keyframes ld-stage-out { to { transform: translate3d(0, -6vh, 0); opacity: 0; } }
  @keyframes ld-fall { 0% { opacity: 1; transform: translate3d(0, 0, 0) scaleY(.8); } 100% { opacity: .9; transform: translate3d(0, 32vh, 0) scaleY(1.25); } }
  @keyframes ld-up { to { transform: translate3d(0, -100%, 0); } }
  @keyframes ld-down { to { transform: translate3d(0, 100%, 0); } }

  .loader__skip {
    position: absolute; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1.1rem; border-radius: var(--r-pill);
    border: 1px solid var(--line); background: transparent; color: var(--fg-muted);
    font-family: var(--font-brand); font-size: .7rem; letter-spacing: .2em; text-transform: uppercase;
  }
  .loader__skip:hover { color: var(--fg); border-color: var(--aqua); }
  @media (prefers-reduced-motion: reduce) { :global(html.rw-intro) .loader { display: none; } }
</style>
