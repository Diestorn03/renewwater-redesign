---
// Map facade: nothing from Google loads until the visitor asks for it (spec §8). 16:10 box, iframe injected on click.
import { useI18n, pick } from '../../i18n/index.js';
import copy from '../../i18n/areas/contact.js';
import { mapEmbed, address } from '../../data/site.js';
import Icon from '../ui/Icon.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
const { lang } = useI18n(Astro);
const m = pick(copy, lang).map;

// abstract "contour" art (water ripples, not a real map): wobbly rings around the pin + a few roads
const ring = (r, k) => {
  const pts = Array.from({ length: 48 }, (_, i) => {
    const a = (i / 48) * Math.PI * 2;
    const rr = r * (1 + 0.07 * Math.sin(a * 3 + k) + 0.04 * Math.sin(a * 5 - k * 1.7));
    return `${(160 + Math.cos(a) * rr * 1.5).toFixed(1)} ${(84 + Math.sin(a) * rr).toFixed(1)}`;
  });
  return `M${pts.join(' L')} Z`;
};
const rings = [14, 26, 40, 56, 74, 94, 116, 140].map((r, i) => ring(r, i * 0.9));
---
<div class:list={['mapf', cls]}>
  <div class="mapf__box" data-mapf-box>
    <svg class="mapf__art" viewBox="0 0 320 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      {rings.map((d, i) => <path d={d} class="mapf__ring" style={`opacity:${(0.5 - i * 0.05).toFixed(2)}`} />)}
      <path class="mapf__road" d="M-10 150 C 80 128 150 118 330 60" />
      <path class="mapf__road" d="M60 -10 C 90 60 120 130 150 210" />
      <path class="mapf__road mapf__road--thin" d="M-10 70 C 90 80 200 96 330 120" />
    </svg>
    <span class="mapf__ping" aria-hidden="true"></span>
    <svg class="mapf__pin" width="40" height="50" viewBox="0 0 40 50" aria-hidden="true" focusable="false">
      <path d="M20 1C30.5 1 39 9.3 39 19.6 39 33 20 49 20 49S1 33 1 19.6C1 9.3 9.5 1 20 1Z" fill="url(#rw-grad)" />
      <circle cx="20" cy="19.5" r="7" fill="#001C38" />
    </svg>
    <span class="mapf__addr mono" aria-hidden="true">{address.city}</span>
    <button type="button" class="mapf__load" data-mapf-load data-src={mapEmbed} data-title={m.title}>
      <Icon name="pin" size={18} />{m.show}
    </button>
  </div>
  <p class="mapf__note">{m.privacy}</p>
</div>

<script>
  // one delegated listener for every facade on every page (module scripts run once under ClientRouter)
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest?.('[data-mapf-load]') as HTMLButtonElement | null;
    if (!btn) return;
    const box = btn.closest('[data-mapf-box]') as HTMLElement;
    const frame = document.createElement('iframe');
    frame.src = btn.dataset.src || '';
    frame.title = btn.dataset.title || '';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    frame.allowFullscreen = true;
    box.replaceChildren(frame);
    box.classList.add('is-live');
    frame.focus();
  });
</script>

<style>
  .mapf { display: grid; gap: .5rem; }
  .mapf__box {
    position: relative; aspect-ratio: 16 / 10; border-radius: var(--r-md); overflow: hidden; isolation: isolate;
    background: radial-gradient(120% 90% at 50% 48%, #0A4A66 0%, #062B4F 45%, #001C38 100%);
    box-shadow: inset 0 0 0 1px rgba(143, 179, 196, .18);
    display: grid; place-items: center;
  }
  .mapf__box :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mapf__art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .mapf__ring { fill: none; stroke: #00D0D0; stroke-width: .8; vector-effect: non-scaling-stroke; }
  .mapf__road { fill: none; stroke: rgba(234, 251, 249, .16); stroke-width: 5; stroke-linecap: round; }
  .mapf__road--thin { stroke-width: 2.5; stroke: rgba(234, 251, 249, .1); }
  .mapf__pin { position: absolute; left: 50%; top: 42%; translate: -50% -100%; filter: drop-shadow(0 10px 14px rgba(0, 208, 208, .45)); }
  .mapf__ping {
    position: absolute; left: 50%; top: 42%; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%;
    border: 1px solid var(--aqua); animation: mapf-ping 2.4s var(--ease-out) infinite;
  }
  .mapf__addr { position: absolute; left: 50%; top: calc(42% + 16px); translate: -50% 0; color: #EAFBF9; opacity: .75; white-space: nowrap; }
  .mapf__load {
    position: absolute; left: 50%; bottom: 14px; translate: -50% 0;
    display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: 0 1.2rem; border-radius: var(--r-pill);
    border: 0; background: #fff; color: var(--navy); font-weight: 600; font-size: .9rem; white-space: nowrap;
    box-shadow: var(--sh-float); transition: transform var(--d-base) var(--ease-water);
  }
  .mapf__load:hover { transform: translateY(-2px); }
  .mapf__load:focus-visible { outline: 3px solid var(--aqua); outline-offset: 3px; }
  .mapf__note { font-size: .8rem; color: var(--fg-muted); }
  @keyframes mapf-ping { 0% { transform: scale(.6); opacity: 1 } 80%, 100% { transform: scale(4.5); opacity: 0 } }
  @media (prefers-reduced-motion: reduce) { .mapf__ping { animation: none; opacity: 0; } }
</style>
