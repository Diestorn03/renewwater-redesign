---
// GitHub Pages serves this one 404.html for every missing path: English URLs are sent to /en/not-found/,
// the same page inside the English chrome (nav, footer, lang="en").
import Base from '../layouts/Base.astro';
import NotFound from '../components/chrome/NotFound.astro';
import { useI18n } from '../i18n/index.js';
import es from '../i18n/es.js';
import en from '../i18n/en.js';
const { base } = useI18n(Astro);
const enPrefix = `${base}/en/`;
const enPage = `${base}/en/not-found/`;
---
<Base title={`${es.meta.notFound} · ${en.meta.notFound}`}>
  <script slot="head" is:inline define:vars={{ enPrefix, enPage }}>
    if (location.pathname.indexOf(enPrefix) === 0) location.replace(enPage);
  </script>
  <NotFound primary="es" />
</Base>
